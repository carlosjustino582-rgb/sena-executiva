generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]
  auditEntries Audit[]

  @@map("users")
}

model Session {
  idHash    String   @id @map("id_hash")
  userId    Int      @map("user_id")
  csrf      String
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Article {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  category    String   @default("Gestão")
  bodyJson    String   @default("[]") @map("body_json")
  art         String   @default("xadrez")
  readMinutes Int      @default(4) @map("read_minutes")
  featured    Boolean  @default(false)
  trending    Boolean  @default(false)
  status      String   @default("draft")
  createdAt   DateTime @default(now()) @map("created_at")
  publishedAt String?  @map("published_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  imageUrl    String?  @map("image_url")

  @@index([status, publishedAt(sort: Desc)])
  @@map("articles")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  status    String   @default("active")

  @@map("subscribers")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new")
  notes     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contacts")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model Audit {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit")
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@map("rate_limits")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model RevokedToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("revoked_tokens")
}

model Ad {
  id             Int      @id @default(autoincrement())
  name           String
  slot           String
  imageUrl       String?  @map("image_url")
  imageMobileUrl String?  @map("image_mobile_url")
  href           String   @default("")
  alt            String   @default("")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  @@index([slot, active])
  @@map("ads")
}

model Category {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  color    String  @default("#1B2F6E")
  isTop    Boolean @default(false) @map("is_top")
  position Int     @default(100)

  @@map("categories")
}

model Slide {
  id        Int      @id @default(autoincrement())
  imageUrl  String   @map("image_url")
  caption   String   @default("")
  href      String   @default("")
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("slides")
}

model Sponsored {
  id        Int      @id @default(autoincrement())
  brand     String   @default("")
  title     String
  text      String   @default("")
  cta       String   @default("Saber mais")
  href      String   @default("")
  imageUrl  String?  @map("image_url")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("sponsored")
}

model Partner {
  id        Int      @id @default(autoincrement())
  name      String
  imageUrl  String   @map("image_url")
  href      String   @default("")
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("partners")
}

model SqliteImport {
  sourcePath String   @id @map("source_path")
  importedAt DateTime @default(now()) @map("imported_at")

  @@map("sqlite_imports")
}
